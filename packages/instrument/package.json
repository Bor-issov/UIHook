{
  "name": "@uihook/instrument",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@uihook/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "@uihook/source": "./src/vite.ts",
      "types": "./dist/vite.d.ts",
      "default": "./dist/vite.js"
    },
    "./attributes": {
      "@uihook/source": "./src/attributes.ts",
      "types": "./dist/attributes.d.ts",
      "default": "./dist/attributes.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@babel/parser": "^8.0.5",
    "@babel/types": "^8.0.5",
    "magic-string": "^1.3.1"
  },
  "peerDependencies": {
    "vite": ">=6"
  },
  "devDependencies": {
    "vite": "^8.3.0"
  }
}
