{
  "name": "@uihook/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:chrome && pnpm build:firefox",
    "build:chrome": "node scripts/build.mjs --browser chrome",
    "build:firefox": "node scripts/build.mjs --browser firefox",
    "watch:chrome": "node scripts/build.mjs --browser chrome --watch",
    "watch:firefox": "node scripts/build.mjs --browser firefox --watch",
    "lint:firefox": "web-ext lint --source-dir dist/firefox --self-hosted",
    "package:chrome": "web-ext build --source-dir dist/chrome --artifacts-dir artifacts --filename uihook-chrome-{version}.zip --overwrite-dest",
    "package:firefox": "web-ext build --source-dir dist/firefox --artifacts-dir artifacts --filename uihook-firefox-{version}.zip --overwrite-dest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@uihook/instrument": "workspace:*",
    "@uihook/protocol": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.9",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "web-ext": "^10.6.0"
  }
}
