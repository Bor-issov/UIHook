{
  "name": "uihook",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build && pnpm --filter @uihook/companion run build && pnpm --filter @uihook/extension run build",
    "build:packages": "pnpm -r --filter \"./packages/**\" run build",
    "dev:companion": "pnpm --filter @uihook/companion run dev --root ../../examples/react-vite-demo",
    "dev:demo": "pnpm --filter react-vite-demo run dev",
    "test": "vitest run",
    "typecheck": "pnpm -r run typecheck",
    "e2e": "node scripts/e2e.mjs",
    "check": "pnpm typecheck && pnpm test",
    "dev:extension": "pnpm --filter @uihook/extension run watch"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "playwright": "^1.63.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
