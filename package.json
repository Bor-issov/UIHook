{
  "name": "uihook",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build && pnpm --filter @uihook/companion run build && pnpm --filter @uihook/extension run build",
    "build:packages": "pnpm -r --filter \"./packages/**\" run build",
    "dev:companion": "pnpm --filter @uihook/companion run dev --root ../../examples/react-vite-demo",
    "dev:demo": "pnpm --filter react-vite-demo run dev",
    "test": "vitest run",
    "typecheck": "pnpm -r run typecheck",
    "e2e": "node scripts/e2e/run.mjs",
    "check": "pnpm typecheck && pnpm test",
    "dev:extension": "pnpm --filter @uihook/extension watch:chrome",
    "e2e:chrome": "node scripts/e2e/run.mjs --browser chromium",
    "e2e:firefox": "node scripts/e2e/run.mjs --browser firefox",
    "e2e:setup": "pnpm exec playwright install chromium && node scripts/e2e/test-browsers.mjs",
    "dev:chrome": "node scripts/dev.mjs --browser chrome",
    "dev:firefox": "node scripts/dev.mjs --browser firefox",
    "build:chrome": "pnpm build:packages && pnpm --filter @uihook/extension build:chrome",
    "build:firefox": "pnpm build:packages && pnpm --filter @uihook/extension build:firefox",
    "package:chrome": "pnpm build:chrome && pnpm --filter @uihook/extension package:chrome",
    "package:firefox": "pnpm build:firefox && pnpm --filter @uihook/extension lint:firefox && pnpm --filter @uihook/extension package:firefox",
    "smoke:agent": "node scripts/agent-smoke.mjs"
  },
  "devDependencies": {
    "@puppeteer/browsers": "^3.2.2",
    "@types/node": "^26.5.1",
    "playwright": "^1.63.0",
    "puppeteer-core": "^25.10.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
